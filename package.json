{
    "name": "mentorias-scrum-whatsapp",
    "version": "1.0.0",
    "description": "Website com integração nativa de WhatsApp usando Express, Socket.io e whatsapp-web.js",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev:backend": "nodemon src/server.js",
        "dev:frontend": "npm --prefix frontend run dev",
        "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
        "build:frontend": "npm --prefix frontend run build",
        "build": "npm --prefix frontend install --legacy-peer-deps && npm run build:frontend",
        "install:frontend": "npm --prefix frontend install",
        "lint": "eslint src/ public/js/ scripts/ tests/",
        "format": "prettier --write .",
        "test": "jest"
    },
    "keywords": [
        "nodejs",
        "express",
        "whatsapp",
        "whatsapp-web.js",
        "socket.io",
        "dashboard"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@supabase/supabase-js": "^2.43.4",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-rate-limit": "^8.5.2",
        "nodemailer": "^9.0.3",
        "qrcode": "^1.5.3",
        "socket.io": "^4.7.5",
        "whatsapp-web.js": "^1.24.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.2.0",
        "concurrently": "^8.2.2",
        "eslint": "^9.2.0",
        "globals": "^15.1.0",
        "jest": "^29.7.0",
        "nodemon": "^3.1.0",
        "prettier": "^3.2.5"
    }
}
