# Server Configuration
PORT=3000

# CORS Allowed Origin (optional)
# ALLOWED_ORIGIN=http://localhost:3000

# Supabase (Leads database)
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key

# Email Configuration (Nodemailer / Contact Form)
# For Gmail, you can use smtp.gmail.com with port 587 and an App Password.
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
CONTACT_RECEIVER_EMAIL=contato@mentoriasscrum.com.br

# Google Places API (Reviews / Testimonials)
# If left empty, the site will automatically fallback to high-quality mock reviews based on real Google reviews.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
